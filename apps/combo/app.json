  "config": {
    "comment": "Candidates as in M Vitals (scaling, dme, xdrive) and eDrive (battery): the first that answers with a plausible value is used and asked first from then on. Copied, so this app can be tuned without changing those apps; see their app.json comments for the format.",
    "scaling": {
      "rpm": {
        "factor": 0.25,
        "offset": 0,
        "invalid": 65535
      },
      "speed": {
        "factor": 0.015625,
        "offset": 0,
        "invalid": 65535
      },
      "accel": {
        "factor": 0.002,
        "offset": -65,
        "invalid": 65535
      },
      "ambient": {
        "factor": 0.5,
        "offset": -40,
        "invalid": 255
      },
      "engineTemp": {
        "factor": 1,
        "offset": -48,
        "invalid": 255
      },
      "gearboxTemp": {
        "factor": 1,
        "offset": -48,
        "invalid": 255,
        "note": "a value that never changes is shown as no data (some cars don't fill this field); raw values go to the log ('raw gearbox oil')"
      },
      "boost": {
        "factor": 0.01,
        "offset": 0,
        "invalid": 255,
        "note": "sport display boost; raw values go to the log ('raw FES boost')"
      },
      "torque": {
        "factor": 0.5,
        "offset": -1023.5,
        "invalid": 65535,
        "invalidFrom": 4095,
