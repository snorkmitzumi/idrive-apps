{
  "id": "combo",
  "title": "Combo",
  "description": "Tabs of one app: Driving (engine, boost, power, xDrive, batteries in M Vitals' look), Performance (Virtual Dyno beside Drag Timer), Seats, M View (tyres, oil, coolant and gearbox temperatures, misfires per cylinder, fuel trims and timing) and Ambient config's colours, animations and driving modes",
  "version": "2.7.0",
  "vendor": "custom",
  "loggingId": "OAA3",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "autostart": true,
  "include": {
    "ambient_config": [
      "ambient_page.js",
      "ambient.js",
      "cabin.js",
      "control.js",
      "lights.js",
      "lin.js",
      "modes_tab.js",
      "others.js",
      "owner.js",
      "scenes.js"
    ]
  },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "day or night: dimmer at night",
      "statusDayNightChangeOver": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusVehiclePartType": "rs"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "_optional": "the tyres beside xDrive",
      "statusTyreTemperature": "rs",
      "statusTyrePressure": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusVehicleDynamicEngine": "rs",
      "statusActualValueTorque2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "gearbox oil temperature; the xDrive split then comes from the transfer case or the drive mode",
      "basicDataSet": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "statusMSystem": "rs",
      "dataDisplayGearbox": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: nothing read, so it can sleep",
      "VehicleCondition": "s",
      "vehicleConditionNoCrc": "s"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "_optional": "the cluster's eDRIVE needle: logged once, to see whether a mild hybrid sends it",
      "statusPowerRelativHybrid": "rs"
    },
    "de.bmw.powertrain.Powertrain": {
      "_optional": "xDrive column: wheel slip, front axle against rear",
      "ActualValueRPMWheel": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "Performance tab: the car's acceleration (dyno power, peak g)",
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.misc.ComfortFunctionIuK": {
      "ambientLightInteriorColour": "w",
      "statusAmbientLightInteriorColour": "rs"
    },
    "de.bmw.body.Light": {
      "_optional": "the turn signals: that side's lights breathe green",
      "StatusFunctionsIndicators": "s"
    },
    "de.bmw.body.DoorsWindowsRoofMirrors": {
      "_optional": "an open door: its lights red",
      "CentralLockingSystemAndPanelStatus": "s"
    },
    "de.bmw.body.seat.SeatTargetAdjustment": {
      "_optional": "the Seats tab: the driver seat's position (reading only, for now)",
      "_methods": [
        "getCurrentPosition"
      ]
    },
    "de.bmw.infotainment.misc.SeatFunction": {
      "_optional": "the Seats tab: BMW's own seat functions listened to (memory buttons, memory status, easy entry setting; reading only)",
      "statusSeatAdjustment": "rs",
      "statusSeatAdjustmentDR": "rs",
      "statusSeatAdjustmentPS": "rs",
      "statusConfigSMFAMode": "rs",
      "operationSeatMenuDR": "s",
      "operationSeatMenuPS": "s",
      "statusRemoteControlSeatAdjustmentDRPS": "rs"
    },
    "com.harman.infotainment.systeminfrastructure.seatcommandproxy.seatcommandproxy.SeatCommandProxyCtrl": {
      "_optional": "the Seats tab: the head unit's seat proxy listened to (its status only)",
      "_instances": "Inst1",
      "seatProxySeatOperationStatus": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
